<?xml version="1.0" encoding="utf-8"?>
<!-- Kroste-Standard: viel loggen. Datei = Trace, Konsole = Info.

     logDir wird in Program.Main aus AppPaths.StateRoot gesetzt, BEVOR der
     erste Logger laeuft. Vorher stand hier ein relatives "logs/" — und das
     loest NLog gegen das Arbeitsverzeichnis auf. Beim AppImage ist das der
     read-only Mount bzw. der Ordner, aus dem gestartet wurde: es entstand
     schlicht kein Log. Der Fallback unten greift nur, wenn das Setzen der
     Variable fehlschlaegt. -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${var:logDir}/nlog-internal.log">

  <variable name="logDir" value="logs" />

  <targets>
    <target xsi:type="File" name="file"
            fileName="${var:logDir}/KroModIx.log"
            archiveFileName="${var:logDir}/archive/KroModIx.{#}.log"
            archiveEvery="Day"
            maxArchiveFiles="14"
            layout="${longdate}|${level:uppercase=true}|${logger}|${masked:inner=${message}}${onexception:inner=|${exception:format=tostring}}" />

    <target xsi:type="ColoredConsole" name="console"
            layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${masked:inner=${message}}${onexception:inner=|${exception:format=message}}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
